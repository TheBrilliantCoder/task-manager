<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
  http://maven.apache.org/POM/4.0.0
  https://maven.apache.org/xsd/maven-4.0.0.xsd">

<modelVersion>4.0.0</modelVersion>

<groupId>com.badlogic</groupId>   <!-- package namespace -->
<artifactId>task-manager</artifactId>   <!-- project name -->
<version>1.0-SNAPSHOT</version>

<properties>
  <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  <maven.compiler.release>21</maven.compiler.release>   <!-- compile project for Java 21 -->
</properties>

<!-- for any JUnit dependencies, use the version defined by JUnit's BOM -->
<dependencyManagement>
  <dependencies>
    <dependency>
      <groupId>org.junit</groupId>
      <artifactId>junit-bom</artifactId>
      <version>6.1.3</version>
      <type>pom</type>
      <scope>import</scope>
    </dependency>
  </dependencies>
</dependencyManagement>

<dependencies>

  <!-- JUnit Jupiter -->
  <dependency>
    <groupId>org.junit.jupiter</groupId>
    <artifactId>junit-jupiter</artifactId>
    <scope>test</scope>   <!-- use for test only -->
  </dependency>

  <!-- Gson -->
  <dependency>
    <groupId>com.google.code.gson</groupId>
    <artifactId>gson</artifactId>
    <version>2.14.0</version>
  </dependency>

</dependencies>

<!-- plugins Maven uses when building -->
<build>
  <plugins>

    <plugin>
      <artifactId>maven-surefire-plugin</artifactId>    <!-- plugin to run tests -->
      <version>3.5.6</version>
    </plugin>

    <plugin>
      <groupId>org.apache.maven.plugins</groupId>
      <artifactId>maven-shade-plugin</artifactId>
      <version>3.6.2</version>

      <executions>
        <execution>
          <phase>package</phase>
          <goals>
            <goal>shade</goal>
          </goals>

          <configuration>
            <!-- 1. ADD THIS FILTERS SECTION -->
            <filters>
              <filter>
                <artifact>*:*</artifact> <!-- Applies to all dependencies -->
                <excludes>
                  <!-- Fixes the overlapping resource warning -->
                  <exclude>META-INF/MANIFEST.MF</exclude>
                  <!-- Fixes the overlapping module-info class warning -->
                  <exclude>META-INF/versions/9/module-info.class</exclude>
                  <!-- Best practice: Exclude jar signatures to prevent security exceptions -->
                  <exclude>META-INF/*.SF</exclude>
                  <exclude>META-INF/*.DSA</exclude>
                  <exclude>META-INF/*.RSA</exclude>
                </excludes>
              </filter>
            </filters>

            <transformers>
              <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                <mainClass>com.badlogic.taskmanager.Main</mainClass>
              </transformer>
            </transformers>
          </configuration>
        </execution>
      </executions>
    </plugin>

    <!-- Prepare the JAR for jpackage -->
    <!-- This plugin let Maven perform file-operation commands -->
    <plugin>
      <groupId>org.apache.maven.plugins</groupId>
      <artifactId>maven-antrun-plugin</artifactId>
      <version>3.1.0</version>
      <executions>
        <execution>
          <id>prepare-jpackage</id>
          <phase>package</phase>
          <goals>
            <goal>run</goal>
          </goals>

          <configuration>
            <target>
              <!-- Create an isolated folder containing only the JAR to package -->
              <mkdir dir="${project.build.directory}/package-input"/>
              <!-- Copy the shaded JAR into the jpackage input folder -->
              <copy
                file="${project.build.directory}/${project.build.finalName}.jar"
                todir="${project.build.directory}/package-input"/>
            </target>
          </configuration>
        </execution>
      </executions>
    </plugin>

    <plugin>
      <groupId>org.codehaus.mojo</groupId>
      <artifactId>exec-maven-plugin</artifactId>
      <version>3.5.0</version>

      <!-- Execute jpackage to create the application installer -->
      <!-- This plugin let Maven run external programs -->
      <executions>
        <execution>
          <id>create-installer</id>  <!-- Creates a .deb installer on Linux -->
          <phase>package</phase>
          <goals>
            <goal>exec</goal>
          </goals>

          <configuration>
            <executable>jpackage</executable>

            <arguments>
              <argument>--type</argument>
              <argument>deb</argument>

              <argument>--name</argument>
              <argument>TaskManager</argument>

              <argument>--input</argument>
              <argument>${project.build.directory}/package-input</argument>

              <argument>--main-jar</argument>
              <argument>${project.build.finalName}.jar</argument>

              <argument>--main-class</argument>
              <argument>com.badlogic.taskmanager.Main</argument>

              <argument>--dest</argument>
              <argument>${project.build.directory}/dist</argument>
            </arguments>
          </configuration>
        </execution>
      </executions>
    </plugin>

  </plugins>
</build>

</project>
